## term → {title, simple, precise, aliases: PackedStringArray, explicit_only: bool}
static var ENTRIES: Dictionary = _build()


static func _build() -> Dictionary:
	var out := {}
	for row in _ROWS:
		out[row[0]] = {
			"title": row[1], "simple": row[2], "precise": row[3],
			"aliases": PackedStringArray(row[4]), "explicit_only": row[0] in EXPLICIT_ONLY,
		}
	return out
